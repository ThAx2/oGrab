#!/usr/bin/env python3
"""oGrab - Lee archivos nmap -oG (grepable) y saca los puertos abiertos.

Uso:
    python3 ograb.py scan.gnmap
    python3 ograb.py scan1.gnmap scan2.gnmap     # varios archivos
    python3 ograb.py scan.gnmap --all            # incluye closed/filtered
    python3 ograb.py scan.gnmap --no-copy        # no copia al clipboard

Salida:
    Nombre (archivo) + tabla de puertos y servicios
    Lista tipo 22,80,443 copiada al clipboard
"""
import argparse
import os
import shutil
import subprocess
import sys


def parse_gnmap(path, only_open=True):
    """Devuelve lista de (host, [(puerto, proto, estado, servicio, version), ...])."""
    hosts = []
    with open(path, "r", errors="ignore") as f:
        for line in f:
            if not line.startswith("Host:") or "Ports:" not in line:
                continue
            head = line.split("\t")[0]  # "Host: 10.0.0.1 (nombre)"
            parts = head.split(None, 2)
            ip = parts[1] if len(parts) > 1 else "?"
            name = parts[2].strip("() \n") if len(parts) > 2 else ""
            host = f"{ip} ({name})" if name else ip

            ports_raw = line.split("Ports:", 1)[1].split("\t")[0]
            ports = []
            for item in ports_raw.split(","):
                f_ = item.strip().split("/")
                if len(f_) < 5 or not f_[0].isdigit():
                    continue
                port, state, proto, _, service = f_[0], f_[1], f_[2], f_[3], f_[4]
                version = f_[6] if len(f_) > 6 else ""
                if only_open and state != "open":
                    continue
                ports.append((int(port), proto, state, service or "unknown", version))
            if ports:
                hosts.append((host, ports))
    return hosts


def copy_to_clipboard(text):
    cmds = [
        ["pbcopy"],                              # macOS
        ["clip.exe"],                            # WSL / Windows
        ["wl-copy"],                             # Wayland
        ["xclip", "-selection", "clipboard"],    # X11
        ["xsel", "--clipboard", "--input"],      # X11
    ]
    for cmd in cmds:
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, input=text.encode(), check=True)
                return True
            except Exception:
                continue
    try:
        import pyperclip  # pip install pyperclip
        pyperclip.copy(text)
        return True
    except Exception:
        return False


def main():
    ap = argparse.ArgumentParser(description="oGrab: puertos de un nmap -oG al clipboard")
    ap.add_argument("files", nargs="+", help="archivo(s) .gnmap / -oG")
    ap.add_argument("--all", action="store_true", help="incluir puertos no abiertos")
    ap.add_argument("--no-copy", action="store_true", help="no copiar al clipboard")
    args = ap.parse_args()

    all_ports = set()
    for path in args.files:
        if not os.path.isfile(path):
            print(f"[!] No existe: {path}", file=sys.stderr)
            continue
        hosts = parse_gnmap(path, only_open=not args.all)
        print(f"\n=== {os.path.basename(path)} ===")
        if not hosts:
            print("  (sin puertos)")
            continue
        for host, ports in hosts:
            print(f"\n  {host}")
            for port, proto, state, svc, ver in sorted(ports):
                extra = f"  {ver}" if ver else ""
                st = "" if state == "open" else f" [{state}]"
                print(f"    {port:>5}/{proto:<3}  {svc}{st}{extra}")
                all_ports.add(port)

    if not all_ports:
        print("\n[!] No se encontraron puertos.")
        return

    csv = ",".join(str(p) for p in sorted(all_ports))
    print(f"\nPuertos: {csv}")
    if not args.no_copy:
        if copy_to_clipboard(csv):
            print("[+] Copiado al clipboard")
        else:
            print("[!] No pude copiar (instala xclip/wl-clipboard o pyperclip)")


if __name__ == "__main__":
    main()
